# Copy to .env and adjust. Never commit .env.

# PostgreSQL (docker compose up -d gives you this locally)
DATABASE_URL="postgresql://bunny:bunny@localhost:5432/bunny_dev"

# Used only by the test suite (created automatically by docker/initdb)
TEST_DATABASE_URL="postgresql://bunny:bunny@localhost:5432/bunny_test"

# Better Auth session secret.
#
# ALWAYS generate your own — never ship the value below:
#   openssl rand -base64 32
#
# With NODE_ENV=production the app refuses to start on anything shorter than
# 32 characters or with fewer than 12 distinct characters, because Better
# Auth itself wants 32+ and a padded placeholder would otherwise pass a
# plain length check. `next build` runs as production, so a deployment with a
# weak secret fails at BUILD time rather than shipping and being exploitable.
BETTER_AUTH_SECRET="generate-your-own-with-openssl-rand-base64-32"

# Public origin of the app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sign-in attempts allowed per IP per 15 minutes (default 10). Only raise it
# where many brand-new accounts legitimately sign in from one address — the
# browser test suite (npm run test:e2e) provisions a fresh child per test.
# Never set this in production.
# AUTH_SIGNIN_RATE_MAX=1000

# The weekly family email (optional). Without these, the app runs as before
# and the teacher's "Weekly family email" panel says email isn't set up.
#   RESEND_API_KEY     an API key from resend.com (sending access is enough)
#   FAMILY_EMAIL_FROM  a sender on a domain verified in Resend
#   CRON_SECRET        any random string of 16+ characters; Vercel Cron sends
#                      it to /api/cron/family-email (see vercel.json)
# RESEND_API_KEY=
# FAMILY_EMAIL_FROM="Build Bunny <updates@example.com>"
# CRON_SECRET=
