{
  "name": "build-bunny",
  "version": "0.1.0",
  "private": true,
  "description": "Build Bunny — AI & coding learning platform for young learners (NITAQ Academy)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "load-check": "tsx scripts/load-check.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "better-auth": "^1.3.4",
    "blockly": "^13.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-interpreter": "^6.0.2",
    "next": "^15.4.5",
    "next-intl": "^4.3.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "dotenv": "^16.4.7",
    "embedded-postgres": "^16.14.0-beta.17",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.4.5",
    "prettier": "^3.6.2",
    "prisma": "^6.13.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
