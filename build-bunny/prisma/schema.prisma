// Build Bunny — schema v1 (Milestone 1: identity + schools + audit + learning events).
// Domain boundaries (plan §0.1-12): IDENTITY · SCHOOLS · ANALYTICS/AUDIT.
// Curriculum/learning/progress/gamification/certificates arrive in their own
// milestone migrations. Every tenant-owned table denormalizes a non-null schoolId
// so school analytics stay join-free and row-level security can be enabled later
// without schema changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── IDENTITY ───────────────────────────────
// User/Session/Account/Verification are Better Auth-managed models (core +
// username + admin plugins) extended with Build Bunny columns. Security
// primitives (hashing, cookies, CSRF, throttling, revocation) live in the
// framework — our layer is identity/provisioning policy only (plan §0.1-1).

// Role values (validated in code; string column keeps the Better Auth admin
// plugin compatible): SUPER_ADMIN · NITAQ_ADMIN · SCHOOL_ADMIN · TEACHER · STUDENT
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Better Auth `username` plugin. Students log in with a school-scoped
  // username; we store it namespaced (`{schoolCode}__{username}`) so the
  // column stays globally unique while usernames stay per-school.
  username        String? @unique
  displayUsername String?

  // Better Auth `admin` plugin (account disable + impersonation + revocation).
  role       String    @default("STUDENT")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  // Build Bunny extensions.
  schoolId           String?
  displayName        String
  mustChangePassword Boolean @default(false)
  locale             String  @default("en")
  avatarId           String?

  school           School?           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessions         Session[]
  accounts         Account[]
  studentProfile   StudentProfile?
  teacherProfile   TeacherProfile?
  classMemberships ClassMembership[]
  learningEvents   LearningEvent[]
  studentProgress  StudentProgress[]
  attempts         ActivityAttempt[]
  xpEvents         XpEvent[]
  hintUsages       HintUsage[]
  dailyActivity    StudentDailyActivity[]
  achievements     StudentAchievement[]
  feedbackReceived TeacherFeedback[]      @relation("FeedbackForStudent")
  feedbackGiven    TeacherFeedback[]      @relation("FeedbackByTeacher")
  assignmentsMade  Assignment[]
  certificates     Certificate[]

  @@index([schoolId, role])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Better Auth admin plugin: set while a platform admin impersonates.
  impersonatedBy String?

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─────────────────────────────── SCHOOLS ────────────────────────────────

enum SchoolStatus {
  ACTIVE
  INACTIVE
}

model School {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  // Short code students type on the login screen (also namespaces usernames).
  code          String       @unique
  status        SchoolStatus @default(ACTIVE)
  timezone      String       @default("Asia/Dubai")
  defaultLocale String       @default("en")
  logoKey       String?
  // Feature flags (plan §0.1-20): { adventure, aiLab, mlLab, bunnyGuide, ... }
  features      Json         @default("{}")
  // School-week override for streaks; null = Mon–Fri (UAE default).
  weekStructure Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  users            User[]
  licences         Licence[]
  academicYears    AcademicYear[]
  classes          Class[]
  studentProfiles  StudentProfile[]
  teacherProfiles  TeacherProfile[]
  classMemberships ClassMembership[]
  learningEvents   LearningEvent[]
  schoolPrograms   SchoolProgram[]
  studentProgress  StudentProgress[]
  attempts         ActivityAttempt[]
  feedback         TeacherFeedback[]
  assignments      Assignment[]
  certificates     Certificate[]
}

enum LicenceStatus {
  ACTIVE
  GRACE
  READ_ONLY
  SUSPENDED
}

model Licence {
  id        String        @id @default(cuid())
  schoolId  String
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  seats     Int
  startsAt  DateTime
  expiresAt DateTime
  graceDays Int           @default(30)
  status    LicenceStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([schoolId, status])
  @@index([expiresAt])
}

model AcademicYear {
  id       String   @id @default(cuid())
  schoolId String
  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  startsAt DateTime
  endsAt   DateTime
  isActive Boolean  @default(true)

  classes Class[]

  @@unique([schoolId, name])
}

model Class {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  grade          Int
  // Crockford base32, displayed grouped (BB-XXXX-XXXX). Rotatable, disableable.
  joinCode       String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships ClassMembership[]
  assignments Assignment[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId])
}

enum ClassRole {
  TEACHER
  STUDENT
}

model ClassMembership {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ClassRole
  createdAt DateTime  @default(now())

  @@unique([classId, userId])
  @@index([schoolId, userId])
}

model StudentProfile {
  userId            String    @id
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId          String
  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // The school's own student ID from CSV import — dedupe/update key. Never a login secret.
  studentIdentifier String
  grade             Int
  xpTotal           Int       @default(0)
  starsTotal        Int       @default(0)
  streakCurrent     Int       @default(0)
  streakBest        Int       @default(0)
  lastActiveDate    DateTime?
  onboardedAt       DateTime?
  // Curriculum track this student follows (one per student, plan §8 J).
  programId         String?
  program           Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([schoolId, studentIdentifier])
  @@index([schoolId, grade])
}

model TeacherProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

// ────────────────────────────── CURRICULUM ──────────────────────────────
// Platform-global content (no schoolId — schools consume via SchoolProgram).
// The DATABASE is the permanent source of truth for all curriculum entities
// (plan §0.1-2); JSON fixtures are an import format feeding this model.
// Localized text fields are JSONB shaped { en, ar?, arHash? }.

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ActivityType {
  BLOCK_CODING
  CODE_PREDICTION
  DEBUGGING
  SEQUENCING
  // Of the values below, QUIZ / REAL_ML / CREATIVE_PROJECT are registered for
  // later phases (plan §0.1-7) with no engine behind them yet; the rest have
  // shipped engines (see modules/activities server + player registries).
  // Order is load-bearing (Postgres enum) — append only, never reorder.
  QUIZ
  PATTERN_RECOGNITION
  AI_CLASSIFICATION
  REAL_ML
  AI_ETHICS
  CREATIVE_PROJECT
  AI_SIM
  CONCEPT_CARDS
}

enum LearningTrack {
  PROGRAMMING
  AI_CONCEPTS
  MACHINE_LEARNING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Program {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        Json
  description Json?
  gradeMin    Int
  gradeMax    Int
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  worlds          ProgramWorld[]
  schoolPrograms  SchoolProgram[]
  studentProfiles StudentProfile[]
}

// Worlds are reusable across programs (grade-band packaging, plan §1.1 B2).
model ProgramWorld {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  worldId   String
  world     World   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  order     Int

  @@unique([programId, worldId])
  @@unique([programId, order])
}

model World {
  id      String        @id @default(cuid())
  slug    String        @unique
  name    Json
  tagline Json?
  // Rendering theme key for the adventure map (meadow, forest, lab, ...).
  theme   String
  status  ContentStatus @default(DRAFT)
  // Horizon worlds appear as roadmap art on the map with no interactive area
  // (plan §0.1-4: no fake product areas).
  horizon Boolean       @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  programs ProgramWorld[]
  modules  Module[]
}

model Module {
  id          String   @id @default(cuid())
  worldId     String
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  slug        String
  name        Json
  description Json?
  order       Int
  // Optional override of the default previous-module gate (JSON rule DSL).
  unlockRule  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  levels Level[]

  @@unique([worldId, slug])
  @@unique([worldId, order])
}

model Level {
  id           String        @id @default(cuid())
  moduleId     String
  module       Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug         String
  order        Int
  activityType ActivityType
  track        LearningTrack @default(PROGRAMMING)

  title        Json
  story        Json?
  objective    Json?
  instructions Json?
  explanation  Json?
  teacherNotes Json?

  difficulty          Difficulty @default(EASY)
  recommendedGradeMin Int?
  recommendedGradeMax Int?
  estimatedMinutes    Int        @default(5)
  // Null → difficulty-derived platform default (plan §1.2 XP economy).
  xpReward            Int?
  maxStars            Int        @default(3)
  tags                String[]   @default([])

  // Engine config validated by per-activity-type Zod schemas at the app
  // boundary (grids, variants, toolbox, checks, star criteria, solution).
  payload Json
  // Progressive 4-tier hints — server-held, never shipped in student payloads.
  hints   Json

  status             ContentStatus @default(DRAFT)
  publishedVersionId String?       @unique
  arComplete         Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  versions      LevelVersion[]
  prerequisites LevelPrerequisite[] @relation("LevelPrereqTarget")
  requiredBy    LevelPrerequisite[] @relation("LevelPrereqSource")
  progress      StudentProgress[]
  attempts      ActivityAttempt[]
  feedback      TeacherFeedback[]

  @@unique([moduleId, slug])
  @@unique([moduleId, order])
  @@index([status])
}

// Immutable publish snapshots. Attempts and in-flight play pin a version at
// start so a mid-session republish never shifts grading (plan §1.2).
model LevelVersion {
  id            String   @id @default(cuid())
  levelId       String
  level         Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  version       Int
  // Full denormalized level content at publish time (text + payload + hints).
  snapshot      Json
  publishedAt   DateTime @default(now())
  publishedById String?

  @@unique([levelId, version])
}

// Unlocking is linear-by-order per module by default; explicit edges override
// (all edges must be satisfied). Data layer enforces acyclicity.
model LevelPrerequisite {
  id              String @id @default(cuid())
  levelId         String
  level           Level  @relation("LevelPrereqTarget", fields: [levelId], references: [id], onDelete: Cascade)
  requiresLevelId String
  requiresLevel   Level  @relation("LevelPrereqSource", fields: [requiresLevelId], references: [id], onDelete: Cascade)

  @@unique([levelId, requiresLevelId])
}

// Which programs a school has licensed/enabled.
model SchoolProgram {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  enabledAt DateTime @default(now())

  @@unique([schoolId, programId])
}

// ─────────────────────────────── LEARNING ───────────────────────────────

// Absence of a row = LOCKED. Rows exist from first unlock onward.
enum ProgressStatus {
  UNLOCKED
  IN_PROGRESS
  COMPLETED
}

model StudentProgress {
  id            String         @id @default(cuid())
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentUserId String
  student       User           @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  levelId       String
  level         Level          @relation(fields: [levelId], references: [id], onDelete: Cascade)

  status        ProgressStatus @default(UNLOCKED)
  // High-water mark across runs (plan §1.2).
  stars         Int            @default(0)
  attemptsCount Int            @default(0)
  // ORDER | PREREQUISITE | ASSIGNMENT | SEED — how this level opened.
  unlockSource  String         @default("ORDER")
  // Autosaved Blockly workspace (classroom wifi reality, plan §0.1 amendments).
  draftWorkspace   Json?
  draftSavedAt     DateTime?
  firstCompletedAt DateTime?
  lastActivityAt   DateTime?
  // LevelVersion.version the completion was graded against.
  completedVersion Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([studentUserId, levelId])
  @@index([schoolId, levelId])
  @@index([studentUserId, status])
}

// ────────────────────── ATTEMPTS, REWARDS & BADGES (M3) ─────────────────

enum AttemptVerdict {
  PASS
  PARTIAL
  FAIL
  ERROR
}

// PREVIEW attempts (teacher/editor test-play) never touch stats or rewards.
enum AttemptKind {
  NORMAL
  PREVIEW
}

model ActivityAttempt {
  id            String  @id @default(cuid())
  // Client-generated idempotency key: a refreshed/replayed submission can
  // never double-award (plan §0.1-13).
  attemptRunId  String  @unique
  schoolId      String
  school        School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentUserId String
  student       User    @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  levelId       String
  level         Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)
  // Grading pins the published version at submission (plan §1.2).
  levelVersion  Int
  engineVersion String
  kind          AttemptKind @default(NORMAL)

  // Inputs, not frames: replay = deterministic re-run (plan §1.2).
  workspaceJson Json
  generatedCode String
  // Per-variant check results + termination summary.
  resultSummary Json

  verdict          AttemptVerdict
  starsEarned      Int            @default(0)
  xpAwarded        Int            @default(0)
  durationMs       Int?
  blockCount       Int?
  hintTierUsed     Int            @default(0)
  // Client's optimistic verdict — mismatches are telemetry, never authority.
  clientVerdict    String?
  gradeMismatch    Boolean        @default(false)
  viaImpersonation Boolean        @default(false)
  createdAt        DateTime       @default(now())

  @@index([studentUserId, levelId, createdAt])
  @@index([schoolId, createdAt])
  @@index([levelId, verdict])
}

// Append-only XP ledger. Idempotency by design: sources are LEVEL_PASS,
// STAR_2, STAR_3 (star-improvement awards are per star tier), so the
// compound unique makes every award replay-safe without partial indexes.
model XpEvent {
  id            String   @id @default(cuid())
  schoolId      String
  studentUserId String
  student       User     @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  levelId       String?
  source        String
  amount        Int
  attemptId     String?
  createdAt     DateTime @default(now())

  @@unique([studentUserId, levelId, source])
  @@index([schoolId, createdAt])
}

model HintUsage {
  id            String   @id @default(cuid())
  schoolId      String
  studentUserId String
  student       User     @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  levelId       String
  tier          Int
  createdAt     DateTime @default(now())

  @@unique([studentUserId, levelId, tier])
  @@index([schoolId, levelId])
}

// One row per student per active school-day — powers streaks transactionally
// (no cron) and doubles as the analytics time-series (plan §1.2).
model StudentDailyActivity {
  id            String   @id @default(cuid())
  schoolId      String
  studentUserId String
  student       User     @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  // Calendar date in the school's timezone.
  date          DateTime @db.Date
  runs          Int      @default(0)
  completions   Int      @default(0)
  xp            Int      @default(0)

  @@unique([studentUserId, date])
  @@index([schoolId, date])
}

// Platform-global badge definitions; criteria is a data-driven JSON rule
// evaluated inside the grading transaction (plan §1.2).
model Achievement {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        Json
  description Json
  icon        String
  criteria    Json
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  earned StudentAchievement[]
}

model StudentAchievement {
  id            String      @id @default(cuid())
  schoolId      String
  studentUserId String
  student       User        @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime    @default(now())

  @@unique([studentUserId, achievementId])
  @@index([schoolId, earnedAt])
}

// ──────────────────── TEACHING & RECOGNITION (M4) ───────────────────────

// Teacher feedback on a student's work. Attached to a level (not a single
// attempt) so the note survives attempt-payload pruning.
model TeacherFeedback {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentUserId String
  student       User     @relation("FeedbackForStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  teacherUserId String
  teacher       User     @relation("FeedbackByTeacher", fields: [teacherUserId], references: [id], onDelete: Cascade)
  levelId       String
  level         Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  attemptId     String?
  body          String
  readAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId, studentUserId, createdAt])
  @@index([studentUserId, readAt])
}

enum AssignmentTarget {
  WORLD
  MODULE
  LEVEL
}

// Teacher-set work for a class. Assignments may force-unlock their content
// ahead of the normal progression (StudentProgress.unlockSource ASSIGNMENT).
model Assignment {
  id            String           @id @default(cuid())
  schoolId      String
  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId       String
  class         Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  target        AssignmentTarget
  worldId       String?
  moduleId      String?
  levelId       String?
  title         String
  note          String?
  dueAt         DateTime?
  closedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([schoolId, classId, createdAt])
}

enum CertificateKind {
  WORLD_COMPLETION
  PROGRAM_COMPLETION
}

// Issued once per (student, kind, scope). Display fields are FROZEN at issue
// so a certificate stays truthful after a name change or erasure, and the
// public verify page reads only these (plan §1.2 / §0.1-15).
model Certificate {
  id            String          @id @default(cuid())
  schoolId      String
  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: an erased student's certificate stays verifiable.
  studentUserId String?
  student       User?           @relation(fields: [studentUserId], references: [id], onDelete: SetNull)
  kind          CertificateKind
  worldId       String?
  programId     String?

  // Human-readable, printed on the certificate. NOT a lookup key.
  serial        String          @unique
  // Unguessable public lookup key used by the QR/verify URL (anti-enumeration).
  verifySlug    String          @unique

  // Frozen display fields.
  studentName   String
  schoolName    String
  title         Json
  starsEarned   Int             @default(0)
  levelsCount   Int             @default(0)

  issuedAt      DateTime        @default(now())
  revokedAt     DateTime?
  revokeReason  String?

  @@unique([studentUserId, kind, worldId])
  @@index([schoolId, issuedAt])
}

// ─────────────────────────── AUDIT & ANALYTICS ──────────────────────────

enum AuditOutcome {
  SUCCESS
  DENIED
  ERROR
}

// Append-only. Deliberately no FK to User: audit records must survive account
// erasure (legal-basis retention, plan §12 / security doc §5).
model AuditLog {
  id               String       @id @default(cuid())
  createdAt        DateTime     @default(now())
  actorUserId      String?
  actorRole        String?
  onBehalfOfUserId String?
  schoolId         String?
  action           String
  targetType       String?
  targetId         String?
  outcome          AuditOutcome @default(SUCCESS)
  requestId        String?
  ip               String?
  meta             Json?

  @@index([schoolId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

enum LearningEventType {
  STUDENT_LOGIN
  LEVEL_STARTED
  RUN_EXECUTED
  RUN_FAILED
  RUN_SUCCEEDED
  HINT_USED
  LEVEL_COMPLETED
  WORLD_COMPLETED
  ACHIEVEMENT_EARNED
}

// Append-only analytics stream (plan §0.1-14). Minimal payloads only — never
// workspace content or student free text. FK cascade means student erasure
// removes their events (privacy by design).
model LearningEvent {
  id            String            @id @default(cuid())
  createdAt     DateTime          @default(now())
  schoolId      String
  school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentUserId String
  student       User              @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  classId       String?
  type          LearningEventType
  levelId       String?
  worldId       String?
  meta          Json?

  @@index([schoolId, createdAt])
  @@index([studentUserId, createdAt])
  @@index([schoolId, type, createdAt])
}
